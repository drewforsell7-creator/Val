<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Valentine?</title>
  <style>
    :root {
      --bg1: #ffdde1;
      --bg2: #ee9ca7;
      --yes1: #16a34a;
      --yes2: #22c55e;
      --no1: #ef4444;
      --no2: #f87171;
      --text: #1f2937;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      height: 100vh;
      overflow: hidden;
      display: grid;
      place-items: center;
      background: radial-gradient(circle at top, var(--bg1), var(--bg2));
      color: var(--text);
      user-select: none;
      -webkit-user-select: none;
      touch-action: none;
    }

    .card {
      text-align: center;
      padding: 28px 18px;
      width: min(720px, 92vw);
      border-radius: 24px;
      background: rgba(255,255,255,0.35);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.4);
      box-shadow: 0 18px 60px rgba(0,0,0,0.18);
      position: relative;
      z-index: 1;
    }

    h1 {
      margin: 0 0 18px;
      font-size: clamp(28px, 5vw, 48px);
      letter-spacing: 0.3px;
    }

    p {
      margin: 0 0 22px;
      font-size: clamp(14px, 2.2vw, 18px);
      opacity: 0.85;
    }

    /* YES button: huge and stationary */
    #yes {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: clamp(22px, 4vw, 34px);
      padding: 18px 34px;
      border: none;
      border-radius: 18px;
      color: white;
      cursor: pointer;
      background: linear-gradient(135deg, var(--yes1), var(--yes2));
      box-shadow: 0 14px 35px rgba(34, 197, 94, 0.35);
      transform: translateZ(0);
      transition: transform 120ms ease, filter 120ms ease;
      min-width: min(520px, 84vw);
      max-width: 84vw;
    }

    #yes:hover { transform: scale(1.02); filter: brightness(1.02); }
    #yes:active { transform: scale(0.99); }

    /* NO button: small and absolutely positioned (moves around) */
    #no {
      position: fixed;
      left: 70%;
      top: 70%;
      font-size: 12px;
      padding: 8px 12px;
      border: none;
      border-radius: 999px;
      color: white;
      cursor: pointer;
      background: linear-gradient(135deg, var(--no1), var(--no2));
      box-shadow: 0 10px 22px rgba(239, 68, 68, 0.25);
      z-index: 2;
    }

    #result {
      margin-top: 18px;
      font-size: clamp(18px, 3vw, 28px);
      font-weight: 700;
      display: none;
    }

    .hearts {
      pointer-events: none;
      position: fixed;
      inset: 0;
      overflow: hidden;
      z-index: 0;
    }

    .heart {
      position: absolute;
      font-size: 18px;
      opacity: 0.65;
      animation: floatUp linear forwards;
      filter: drop-shadow(0 6px 10px rgba(0,0,0,0.12));
    }

    @keyframes floatUp {
      from { transform: translateY(0) scale(1); opacity: 0.75; }
      to   { transform: translateY(-120vh) scale(1.4); opacity: 0; }
    }

    /* Small helper for mobile */
    .hint {
      margin-top: 10px;
      font-size: 12px;
      opacity: 0.7;
    }
  </style>
</head>
<body>
  <div class="hearts" id="hearts"></div>

  <div class="card">
    <h1>Will you be my Valentine? 💘</h1>
    <p>Choose wisely 😌</p>

    <button id="yes">YES 💖</button>
    <div class="hint">(P.S. the other button is… shy.)</div>

    <div id="result">YAY!!! 💞💞💞</div>
  </div>

  <button id="no">no</button>

  <script>
    const yesBtn = document.getElementById("yes");
    const noBtn = document.getElementById("no");
    const result = document.getElementById("result");
    const heartsLayer = document.getElementById("hearts");

    // --- YES behavior ---
    yesBtn.addEventListener("click", () => {
      result.style.display = "block";
      yesBtn.disabled = true;
      yesBtn.style.filter = "grayscale(0.05)";
      burstHearts(24);
      setInterval(() => burstHearts(10), 900);
    });

    // --- NO movement setup ---
    let vx = 2.2, vy = 1.8;     // bounce velocity
    let dodgeRadius = 120;      // how close the cursor can get
    let lastMove = performance.now();

    function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }

    function randomPosWithinBounds() {
      const pad = 12;
      const bw = noBtn.offsetWidth;
      const bh = noBtn.offsetHeight;
      const x = Math.random() * (window.innerWidth - bw - pad * 2) + pad;
      const y = Math.random() * (window.innerHeight - bh - pad * 2) + pad;
      setNoPos(x, y);
    }

    function getNoPos() {
      return {
        x: parseFloat(noBtn.dataset.x || (window.innerWidth * 0.7)),
        y: parseFloat(noBtn.dataset.y || (window.innerHeight * 0.7))
      };
    }

    function setNoPos(x, y) {
      noBtn.dataset.x = x;
      noBtn.dataset.y = y;
      noBtn.style.transform = `translate(${x}px, ${y}px)`;
    }

    // Initialize NO position using transform so it's smooth
    setNoPos(window.innerWidth * 0.65, window.innerHeight * 0.65);

    // Dodge on mouse move
    window.addEventListener("mousemove", (e) => {
      dodge(e.clientX, e.clientY);
    });

    // Dodge on touch move (mobile)
    window.addEventListener("touchmove", (e) => {
      if (!e.touches || !e.touches[0]) return;
      dodge(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: false });

    function dodge(px, py) {
      const rect = noBtn.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;

      const dx = cx - px;
      const dy = cy - py;
      const dist = Math.hypot(dx, dy);

      if (dist < dodgeRadius) {
        // Push away from pointer, with some randomness
        const push = (dodgeRadius - dist) / dodgeRadius;
        vx += (dx / (dist || 1)) * (3.2 * push) + (Math.random() - 0.5) * 0.6;
        vy += (dy / (dist || 1)) * (3.2 * push) + (Math.random() - 0.5) * 0.6;

        // Cap speed
        const speed = Math.hypot(vx, vy);
        const maxSpeed = 9;
        if (speed > maxSpeed) {
          vx = (vx / speed) * maxSpeed;
          vy = (vy / speed) * maxSpeed;
        }
      }
    }

    // Animate NO button bouncing around
    function tick(t) {
      const dt = Math.min(32, t - lastMove);
      lastMove = t;

      let { x, y } = getNoPos();
      const bw = noBtn.offsetWidth;
      const bh = noBtn.offsetHeight;
      const pad = 10;

      x += vx * (dt / 16);
      y += vy * (dt / 16);

      // Bounce off edges
      if (x < pad) { x = pad; vx *= -1; }
      if (y < pad) { y = pad; vy *= -1; }
      if (x > window.innerWidth - bw - pad) { x = window.innerWidth - bw - pad; vx *= -1; }
      if (y > window.innerHeight - bh - pad) { y = window.innerHeight - bh - pad; vy *= -1; }

      // Slight friction to avoid infinite acceleration
      vx *= 0.995;
      vy *= 0.995;

      setNoPos(x, y);
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    // If they somehow click NO, be playful
    noBtn.addEventListener("click", () => {
      randomPosWithinBounds();
      burstHearts(6);
    });

    // Keep NO within bounds on resize
    window.addEventListener("resize", () => {
      const { x, y } = getNoPos();
      const bw = noBtn.offsetWidth;
      const bh = noBtn.offsetHeight;
      const pad = 10;
      setNoPos(
        clamp(x, pad, window.innerWidth - bw - pad),
        clamp(y, pad, window.innerHeight - bh - pad)
      );
    });

    // --- Heart effects ---
    function burstHearts(n) {
      for (let i = 0; i < n; i++) spawnHeart();
    }

    function spawnHeart() {
      const heart = document.createElement("div");
      heart.className = "heart";
      heart.textContent = ["💖","💘","💝","💗","💕"][Math.floor(Math.random() * 5)];

      const x = Math.random() * window.innerWidth;
      const y = window.innerHeight + 20;
      const duration = 2500 + Math.random() * 2500;
      const size = 14 + Math.random() * 18;

      heart.style.left = `${x}px`;
      heart.style.top = `${y}px`;
      heart.style.fontSize = `${size}px`;
      heart.style.animationDuration = `${duration}ms`;
      heart.style.animationTimingFunction = "linear";

      heartsLayer.appendChild(heart);
      setTimeout(() => heart.remove(), duration + 200);
    }

    // Some ambient hearts at start
    burstHearts(10);
  </script>
</body>
</html>
